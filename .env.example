# pi-gateway — docker compose 환경 설정 예시
#   cp .env.example .env  후 값을 채운다. 비밀값은 여기에 쓰지 않고 $PI_GATEWAY_SECRETS 아래 파일로 둔다
#   (scripts/setup-host.sh가 만든다). 설명: docs/OPERATIONS.md

# ── 공통 ─────────────────────────────────────────────────────────────
# 호스트의 데이터 루트 (절대 경로). workspaces/, plugins/ 가 아래에 생긴다.
PI_GATEWAY_HOME=/srv/pi-gateway
# compose secrets 파일 디렉토리 (절대 경로). 아래에 gateway/, sandboxd/, broker/ 하위 디렉토리가 있다.
PI_GATEWAY_SECRETS=/srv/pi-gateway/secrets
# /var/run/docker.sock 의 그룹 id (stat -c %g /var/run/docker.sock). sandboxd에만 붙는다.
DOCKER_GID=
# rootless Docker면 소켓 경로를 바꾼다 (예: /run/user/1000/docker.sock)
DOCKER_SOCKET_HOST=/var/run/docker.sock
PI_GATEWAY_VERSION=latest
LOG_LEVEL=info

# ── gateway: 공개 포트 ───────────────────────────────────────────────
# 기본 127.0.0.1: 같은 호스트의 reverse proxy(nginx 등)가 TLS를 맡고 이 포트로 넘긴다.
# 직접 공개하려면 LAN IP나 0.0.0.0으로 바꾼다.
GATEWAY_BIND_ADDR=127.0.0.1
GATEWAY_PORT=8080

# 앞단 프록시를 믿을지 (Fastify trustProxy). 권장: 프록시 IP/CIDR 목록(쉼표 구분). 기본 false("0"·빈 값도 같음).
# GATEWAY_BIND_ADDR=127.0.0.1 + 같은 호스트의 reverse proxy라면, gateway가 보는 프록시 주소는 edge 네트워크의 gateway IP다:
#   docker network inspect pi-gateway_edge --format '{{(index .IPAM.Config 0).Gateway}}'   → 예: TRUST_PROXY=172.18.0.1
#   (dockerd를 --userland-proxy=false로 돌린다면 TRUST_PROXY=172.18.0.1,127.0.0.1)
# hop 수(1, 2 …)는 받지 않는다. true는 쓰지 않는다 (아무 클라이언트나 X-Forwarded-For로 IP를 속여 로그인 지연을 우회할 수 있다).
# 프록시 없이 직접 공개할 때는 false로 둔다.
TRUST_PROXY=false

# ── gateway: LLM ─────────────────────────────────────────────────────
# LLM 연결(API 형식, 주소, 키, 모델 목록, 기본 모델)은 관리 화면의 LLM 페이지에서 설정한다 (gateway DB에 저장, 바로 적용).

# ── gateway: 인증 ────────────────────────────────────────────────────
# 키는 환경변수가 아니라 compose secret 파일로 넘긴다 (컨테이너에는 *_FILE 경로만 들어간다).
# 파일은 gateway uid(10001) 소유 0400이다 (scripts/setup-host.sh):
#   $PI_GATEWAY_SECRETS/gateway/api_key              → API_KEY_FILE         서비스 키 (body.user를 믿는다, BFF용)
#   $PI_GATEWAY_SECRETS/gateway/user_api_keys        → USER_API_KEYS_FILE   {"alice":"<32자 이상 키>"} (키가 사용자를 정한다)
#   $PI_GATEWAY_SECRETS/gateway/admin_api_key        → ADMIN_API_KEY_FILE   관리 화면 로그인 키 (비우면 관리 화면 꺼짐)
#   $PI_GATEWAY_SECRETS/gateway/admin_cookie_secret  → ADMIN_COOKIE_SECRET_FILE 관리 화면 세션 쿠키 서명 키
# 빈 파일은 "설정 안 함"으로 본다.
# 키가 하나도 없을 때 인증 없이 열지 (개발용만 1)
AUTH_DISABLED=0

# ── gateway: 세션 ────────────────────────────────────────────────────
# 유휴 세션을 메모리에서 내리는 시간 (다음 요청 때 JSONL에서 되살린다)
SESSION_IDLE_SECONDS=300
# stream=false 요청의 최대 시간 (넘으면 504)
NON_STREAM_TIMEOUT_SECONDS=600
MAX_CONCURRENT_TURNS=16
MAX_CONCURRENT_TURNS_PER_USER=3
TURN_QUEUE_TIMEOUT_SECONDS=120
TURN_QUEUE_MAX_WAITERS=256
SSE_KEEPALIVE_SECONDS=15

# ── gateway: MCP·프롬프트·plugin ────────────────────────────────────
# broker로 넘길 클라이언트 헤더 (쉼표 구분). MCP 템플릿 {{ctx.header:NAME}}으로 쓴다. agent에게는 보이지 않는다.
MCP_FORWARD_HEADERS=
# MCP 템플릿 {{metadata:KEY}}로 쓸 수 있는 요청 metadata 키 (쉼표 구분). 기존 클라이언트가 보내는 대문자 키
# (oh-my-gateway의 METADATA_ENV_ALLOWLIST와 같다). monsemi-frontend MCP는 {{metadata:THREAD_ID}}로 THREAD_ID를 받는다.
# metadata 값은 sandbox 안의 MCP 서버(= agent)에게 보일 수 있으므로 비밀값을 담지 않는다.
MCP_METADATA_KEYS=THREAD_ID,ORCHESTRATOR_URL
# 시스템 프롬프트 {{LANGUAGE}} 값
PROMPT_LANGUAGE=Korean
# 로컬 경로·file:// marketplace 허용. 운영에서는 반드시 0 (gateway 컨테이너 안의 임의 경로를 marketplace로 읽게 된다)
PLUGIN_ALLOW_LOCAL_SOURCES=0
# 관리 화면 정적 파일 위치. 기본 이미지에는 apps/gateway/public/admin에 들어 있으므로 설정하지 않는다
# (비워 두면 기본 경로를 쓴다). 다른 위치를 쓰려면 docker-compose.override.yml에서
# gateway.environment.ADMIN_UI_DIR로 넣는다.

# ── 사내 미러 (이미지 빌드 때만 쓴다. 비우면 공식 저장소) ──────────────────
# Docker Hub의 베이스 이미지는 미러를 쓰지 않는다.
# apt 미러는 bookworm(Node 이미지)과 trixie(Python 이미지)를 모두 제공해야 한다. security를 비우면 APT_MIRROR_URL을 쓴다.
#   APT_MIRROR_URL=http://nexus.corp.com/repository/debian
#   APT_SECURITY_MIRROR_URL=http://nexus.corp.com/repository/debian-security
APT_MIRROR_URL=
APT_SECURITY_MIRROR_URL=
#   NPM_CONFIG_REGISTRY=https://nexus.corp.com/repository/npm/
NPM_CONFIG_REGISTRY=
# HTTP 미러면 PIP_TRUSTED_HOST에 호스트명만 적는다 (예: nexus.corp.com)
#   PIP_INDEX_URL=https://nexus.corp.com/repository/pypi/simple/
PIP_INDEX_URL=
PIP_TRUSTED_HOST=
# egress-proxy의 Go module 미러. 받은 module은 go.sum으로 검증한다.
#   GOPROXY=https://nexus.corp.com/repository/go/
GOPROXY=

# ── sandbox 이미지 ───────────────────────────────────────────────────
# compose가 images/sandbox로 빌드하는 기본 이미지 이름
SANDBOX_BASE_IMAGE=pi-gateway/sandbox:latest
# sandboxd가 실제로 쓰는 이미지. 파생 이미지(FROM pi-gateway/sandbox:latest)를 쓰려면 여기만 바꾼다.
SANDBOX_IMAGE=pi-gateway/sandbox:latest

# ── sandbox egress (egress-proxy) ────────────────────────────────────
# sandbox는 네트워크가 없고(network_mode none) egress-proxy로만 나간다 (HTTP/HTTPS, sandbox의 HTTP(S)_PROXY).
# 프록시는 허용 목록에 있는 목적지만 연다. 비우면 모두 막힌다. 호스트 방화벽 설정은 필요 없다. 설명: docs/OPERATIONS.md §6
# 항목: 도메인(정확히 일치, 와일드카드 없음) 또는 IP·CIDR. ":PORT"를 붙이면 그 포트만 (쉼표·공백 구분).
# loopback·link-local(169.254/16, metadata)은 열 수 없다. IP는 egress-proxy 컨테이너에서 본 주소다.
#   SANDBOX_EGRESS_ALLOW=github.corp.com:443,nexus.corp.com,192.168.10.5:19090
SANDBOX_EGRESS_ALLOW=

# ── sandboxd: 사용자 컨테이너 ────────────────────────────────────────
# 비우면 runc. gVisor를 설치했다면 runsc
SANDBOX_RUNTIME=
SANDBOX_MEMORY=1g
SANDBOX_CPUS=1
SANDBOX_PIDS_LIMIT=256
SANDBOX_TMP_SIZE=256m
SANDBOX_SHM_SIZE=64m
# 이 시간 동안 쓰지 않은 컨테이너는 지운다 (workspace는 남는다)
SANDBOX_IDLE_SECONDS=900
SANDBOX_FS_TIMEOUT_SECONDS=60
# 같은 Docker 호스트에 여러 pi-gateway를 띄울 때 구분값 (세 값 모두 인스턴스마다 다르게 한다)
SANDBOX_INSTANCE=default
SANDBOX_CONTAINER_PREFIX=pi-sbx-
# egress 프록시 socket 볼륨 이름 (compose가 이 이름으로 만들고 sandbox가 mount한다)
SANDBOX_PROXY_VOLUME=pi-gateway-proxy-sock

# ── mcp-broker ───────────────────────────────────────────────────────
# 비밀키가 필요한 stdio MCP 서버를 이미지에 미리 설치한다 (실행 중 npx/uvx 다운로드를 하지 않는다)
BROKER_EXTRA_APT_PACKAGES=
BROKER_EXTRA_NPM_PACKAGES=
BROKER_EXTRA_PIP_PACKAGES=
# stdio 서버마다 배정할 uid 범위 (비우면 broker와 같은 uid로 실행)
BROKER_STDIO_UID_RANGE=20000-20999
# 비어 있지 않으면 이 명령(basename 또는 절대 경로, 쉼표 구분)만 실행한다
BROKER_STDIO_COMMAND_ALLOWLIST=
BROKER_MAX_PROCESSES=64
BROKER_MAX_PROCESSES_PER_SERVER=16
BROKER_MAX_CONNECTIONS=512
BROKER_IDLE_TTL_SECONDS=300
BROKER_CALL_TIMEOUT_CAP_SECONDS=600
BROKER_CONNECT_TIMEOUT_SECONDS=30
BROKER_MAX_RESULT_BYTES=4194304
BROKER_MAX_REQUEST_BODY_BYTES=4194304
BROKER_TOOLS_CACHE_SECONDS=60

# ── 내부 통신 비밀값 (compose secret 파일, 환경변수로 쓰지 않는다) ─────
# 같이 쓰는 값은 서비스마다 같은 값의 사본을 두고, 각 서비스 uid 소유 0400으로 만든다:
#   gateway/sandboxd_jwt_secret (10001) = sandboxd/sandboxd_jwt_secret (1000)  → SANDBOXD_JWT_SECRET_FILE
#   gateway/broker_jwt_secret   (10001) = broker/broker_jwt_secret     (root)  → BROKER_JWT_SECRET_FILE
#   gateway/broker_admin_token  (10001) = broker/broker_admin_token    (root)  → BROKER_ADMIN_TOKEN_FILE
#   broker/broker_kek (root, 정확히 32바이트 base64)                            → BROKER_KEK_FILE
# broker 파일이 root 0400이라 broker가 띄운 stdio MCP 서버(uid 20000+)는 읽을 수 없다.
# 모든 비밀값 변수는 NAME_FILE(파일 경로) 또는 NAME(값) 둘 다 받지만, 운영에서는 _FILE만 쓴다.

# ── 고급 (compose나 이미지가 이미 정해 두는 값, 보통 바꾸지 않는다) ─────
# gateway:    HOST=0.0.0.0 PORT=8080 DATA_DIR=/data PLUGINS_DIR=/opt/plugins
#             SANDBOXD_URL=http://sandboxd:7070 BROKER_URL=http://mcp-broker:7080 BROKER_ADMIN_URL=http://mcp-broker:7081
# sandboxd:   HOST=0.0.0.0 PORT=7070 DOCKER_SOCKET=/var/run/docker.sock WORKSPACES_DIR=/srv/workspaces
#             SANDBOX_REAP_INTERVAL_SECONDS= (기본: SANDBOX_IDLE_SECONDS/4, 5~60초)
# mcp-broker: BROKER_HOST=0.0.0.0 BROKER_ADMIN_HOST=0.0.0.0 BROKER_PORT=7080 BROKER_ADMIN_PORT=7081
#             BROKER_STDIO_PATH=/opt/mcp-venv/bin:/usr/local/bin:/usr/bin:/bin BROKER_STDIO_LANG=C.UTF-8
#             BROKER_STDIO_WORK_ROOT=/tmp/mcp-broker BROKER_STDIO_MAX_MESSAGE_BYTES=16777216
# 바꾸려면 docker-compose.override.yml의 해당 서비스 environment에 넣는다.
